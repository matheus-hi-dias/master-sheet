{
  "description": "Template structures used for structural validation and formula ordering characterization.",
  "evaluateStructure": [
    {
      "name": "base formula",
      "structure": {
        "system": "dnd5e",
        "version": 1,
        "tabs": [
          {
            "id": "main",
            "label": "Main",
            "sections": [
              {
                "id": "core",
                "title": "Core",
                "fields": [
                  { "id": "str", "label": "Strength", "type": "number" },
                  { "id": "dex", "label": "Dexterity", "type": "number" },
                  {
                    "id": "initiative",
                    "label": "Initiative",
                    "type": "formula",
                    "expression": "(str + dex) / 2",
                    "dependencies": ["str", "dex"]
                  }
                ]
              }
            ]
          }
        ]
      },
      "data": { "str": 12, "dex": 14 },
      "expected": { "str": 12, "dex": 14, "initiative": 13 }
    },
    {
      "name": "formula chain evaluated in topological order",
      "structure": {
        "system": "custom",
        "version": 1,
        "tabs": [
          {
            "id": "main",
            "label": "Main",
            "sections": [
              {
                "id": "core",
                "title": "Core",
                "fields": [
                  { "id": "base", "label": "Base", "type": "number" },
                  {
                    "id": "a",
                    "label": "A",
                    "type": "formula",
                    "expression": "base + 1",
                    "dependencies": ["base"]
                  },
                  {
                    "id": "b",
                    "label": "B",
                    "type": "formula",
                    "expression": "a * 2",
                    "dependencies": ["a"]
                  }
                ]
              }
            ]
          }
        ]
      },
      "data": { "base": 2 },
      "expected": { "base": 2, "a": 3, "b": 6 }
    },
    {
      "name": "missing dependency yields null",
      "structure": {
        "system": "custom",
        "version": 1,
        "tabs": [
          {
            "id": "main",
            "label": "Main",
            "sections": [
              {
                "id": "core",
                "title": "Core",
                "fields": [
                  {
                    "id": "broken",
                    "label": "Broken",
                    "type": "formula",
                    "expression": "missing + 1",
                    "dependencies": ["missing"]
                  }
                ]
              }
            ]
          }
        ]
      },
      "data": {},
      "expected": { "broken": null }
    }
  ],
  "cycles": [
    {
      "name": "two-node cycle",
      "structure": {
        "system": "custom",
        "version": 1,
        "tabs": [
          {
            "id": "main",
            "label": "Main",
            "sections": [
              {
                "id": "core",
                "title": "Core",
                "fields": [
                  {
                    "id": "a",
                    "label": "A",
                    "type": "formula",
                    "expression": "b + 1",
                    "dependencies": ["b"]
                  },
                  {
                    "id": "b",
                    "label": "B",
                    "type": "formula",
                    "expression": "a + 1",
                    "dependencies": ["a"]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expectedCycle": ["a", "b"]
    }
  ],
  "valid": [
    {
      "name": "every field type",
      "structure": {
        "system": "dnd5e",
        "version": 1,
        "tabs": [
          {
            "id": "main",
            "label": "Main",
            "icon": "swords",
            "sections": [
              {
                "id": "abilities",
                "title": "Abilities",
                "columns": 2,
                "fields": [
                  {
                    "id": "str",
                    "label": "Strength",
                    "type": "number",
                    "min": 0,
                    "max": 30,
                    "step": 1,
                    "defaultValue": 10
                  },
                  {
                    "id": "notes",
                    "label": "Notes",
                    "type": "textarea",
                    "placeholder": "Enter notes",
                    "maxLength": 500
                  },
                  {
                    "id": "hp_dots",
                    "label": "Hit Dice",
                    "type": "dots",
                    "maxDots": 10,
                    "defaultValue": 3
                  },
                  {
                    "id": "align",
                    "label": "Alignment",
                    "type": "select",
                    "options": [{ "label": "Lawful", "value": "lawful" }]
                  },
                  {
                    "id": "hero",
                    "label": "Hero",
                    "type": "checkbox",
                    "defaultValue": true
                  },
                  {
                    "id": "mod_str",
                    "label": "Modifier",
                    "type": "formula",
                    "expression": "floor((str - 10) / 2)",
                    "dependencies": ["str"]
                  },
                  {
                    "id": "spells",
                    "label": "Spells",
                    "type": "repeater",
                    "itemSchema": [
                      { "id": "name", "label": "Spell name", "type": "text" }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "repeater formula resolves siblings",
      "structure": {
        "system": "custom",
        "version": 1,
        "tabs": [
          {
            "id": "main",
            "label": "Main",
            "sections": [
              {
                "id": "inventory",
                "title": "Inventory",
                "fields": [
                  {
                    "id": "items",
                    "label": "Items",
                    "type": "repeater",
                    "itemSchema": [
                      { "id": "count", "label": "Count", "type": "number" },
                      {
                        "id": "total_weight",
                        "label": "Total weight",
                        "type": "formula",
                        "expression": "count * 2",
                        "dependencies": ["count"]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
