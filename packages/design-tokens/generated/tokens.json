{
  "colors": {
    "dark": {
      "bgApp": "#121212",
      "bgPanel": "#1a1a1b",
      "bgCard": "#242424",
      "textMain": "#e0e0e0",
      "textMuted": "#888888",
      "gold": "#d4af37",
      "goldDim": "#9a7d26",
      "goldTint": "rgba(212, 175, 55, 0.08)",
      "border": "#3d3d3d",
      "danger": "#c0392b",
      "dangerTint": "rgba(192, 57, 43, 0.1)",
      "success": "#27ae60",
      "warning": "#e67e22",
      "link": "#2e78b7",
      "onGold": "#121212"
    },
    "light": {
      "bgApp": "#faf9f6",
      "bgPanel": "#f0efea",
      "bgCard": "#ffffff",
      "textMain": "#2d3436",
      "textMuted": "#636e72",
      "gold": "#b8860b",
      "goldDim": "#8b6914",
      "goldTint": "rgba(184, 134, 11, 0.08)",
      "border": "#dcd7c9",
      "danger": "#c0392b",
      "dangerTint": "rgba(192, 57, 43, 0.1)",
      "success": "#27ae60",
      "warning": "#e67e22",
      "link": "#2e78b7",
      "onGold": "#121212"
    }
  },
  "radii": {
    "card": "8px",
    "pill": "9999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px"
  },
  "typography": {
    "display": {
      "family": "Cinzel",
      "webStack": "'Cinzel', serif"
    },
    "body": {
      "family": "Lato",
      "webStack": "'Lato', sans-serif"
    }
  },
  "shadows": {
    "dark": {
      "card": "0 4px 24px rgba(0, 0, 0, 0.5)",
      "goldGlow": "0 0 16px rgba(212, 175, 55, 0.35)",
      "dotGlow": "0 0 8px rgba(212, 175, 55, 0.5)",
      "tagGlow": "0 0 12px rgba(212, 175, 55, 0.3)"
    },
    "light": {
      "card": "0 4px 12px rgba(0, 0, 0, 0.1)",
      "goldGlow": "0 0 16px rgba(212, 175, 55, 0.35)",
      "dotGlow": "0 0 8px rgba(212, 175, 55, 0.5)",
      "tagGlow": "0 0 12px rgba(212, 175, 55, 0.3)"
    }
  },
  "motion": {
    "duration": {
      "fast": 150,
      "base": 200,
      "theme": 300,
      "dice": 350,
      "drawer": 300
    },
    "easing": {
      "dice": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
      "drawer": "cubic-bezier(0.28, 0.75, 0.25, 1)"
    }
  },
  "auraGradient": "radial-gradient(circle, var(--color-gold) 0%, transparent 70%)",
  "fonts": [
    {
      "family": "Cinzel",
      "file": "Cinzel-VariableFont_wght.ttf",
      "weight": "400 700",
      "style": "normal"
    },
    {
      "family": "Lato",
      "file": "Lato-Regular.ttf",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "SpaceMono",
      "file": "SpaceMono-Regular.ttf",
      "weight": "400",
      "style": "normal"
    }
  ]
}
