{
  "name": "@master-sheet/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Selective, platform-split primitives shared by the Master-Sheet web and mobile apps.",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./button": {
      "types": "./src/button/types.ts",
      "react-native": "./src/button/button.native.tsx",
      "default": "./src/button/button.web.tsx"
    },
    "./tag": {
      "types": "./src/tag/types.ts",
      "react-native": "./src/tag/tag.native.tsx",
      "default": "./src/tag/tag.web.tsx"
    },
    "./gem-logo": {
      "types": "./src/gem-logo/types.ts",
      "react-native": "./src/gem-logo/gem-logo.native.tsx",
      "default": "./src/gem-logo/gem-logo.web.tsx"
    },
    "./dot-tracker": {
      "types": "./src/dot-tracker/types.ts",
      "react-native": "./src/dot-tracker/dot-tracker.native.tsx",
      "default": "./src/dot-tracker/dot-tracker.web.tsx"
    },
    "./button/native": "./src/button/button.native.tsx",
    "./tag/native": "./src/tag/tag.native.tsx",
    "./gem-logo/native": "./src/gem-logo/gem-logo.native.tsx",
    "./dot-tracker/native": "./src/dot-tracker/dot-tracker.native.tsx",
    "./dot": {
      "types": "./src/shared/dot.ts",
      "default": "./src/shared/dot.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "pnpm build && node ../../scripts/run-node-tests.mjs test"
  },
  "dependencies": {
    "@master-sheet/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.83.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@master-sheet/eslint-config": "workspace:*",
    "@master-sheet/typescript-config": "workspace:*",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
