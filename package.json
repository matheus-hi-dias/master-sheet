{
  "name": "master-sheet",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "tokens:generate": "pnpm --filter @master-sheet/design-tokens generate",
    "tokens:check": "pnpm --filter @master-sheet/design-tokens check",
    "check:token-drift": "node scripts/check-token-drift.mjs",
    "check:shared-primitives": "node scripts/check-shared-primitives.mjs",
    "check:web-bundle": "node scripts/check-web-bundle.mjs",
    "verify:design-system": "pnpm tokens:check && pnpm check:token-drift && pnpm check:shared-primitives",
    "verify:workspace": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
