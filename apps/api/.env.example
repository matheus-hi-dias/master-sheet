# Environment example for apps/api
# Copy this file to `.env` and fill values before running the API.

# JWT / Auth
JWT_SECRET=change_me_to_a_strong_secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
AUTH_DEBUG_TOKENS=false

# Database (Postgres)
# Example: postgresql://user:password@localhost:5432/mydb?schema=public
DATABASE_URL=

# URLs and redirects
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Optional template used in verification emails. Use {{token}} placeholder.
# Default behaviour if unset: ${APP_URL}/auth/verify-email?token={{token}}
EMAIL_VERIFY_URL=
# Optional redirect base used by GET /auth/verify-email
EMAIL_VERIFY_REDIRECT_BASE=

# SMTP (optional)
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_SECURE=false

# CORS
# Comma-separated list of allowed origins for CORS, e.g. http://localhost:5173
CORS_ORIGINS=

# Runtime
PORT=3000
NODE_ENV=development

# Mobile (Expo) default API base
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
