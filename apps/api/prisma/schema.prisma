// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  name                    String?
  sheets                  Sheet[]
  templates               Template[]
  refreshTokens           RefreshToken[]
  emailVerified           Boolean                  @default(false)
  failedLoginAttempts     Int                      @default(0)
  lockoutUntil            DateTime?
  createdAt               DateTime                 @default(now())
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model Template {
  id          String  @id @default(uuid())
  name        String
  description String?
  structure   Json
  isPublic    Boolean @default(false)
  author      User    @relation(fields: [authorId], references: [id])
  authorId    String
  sheets      Sheet[]
}

model Sheet {
  id         String   @id @default(uuid())
  character  String
  data       Json
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  template   Template @relation(fields: [templateId], references: [id])
  templateId String
}

/// Persisted, hashed refresh tokens for rotation & revocation
model RefreshToken {
  id         String    @id @default(uuid())
  /// store a hashed value of the refresh token (e.g. SHA256 or bcrypt)
  tokenHash  String    @unique
  jti        String?   @unique
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  revoked    Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  replacedBy String? // id of the next token when rotated
  lastUsedAt DateTime?
  deviceInfo String?
  ip         String?

  @@index([userId])
  @@index([expiresAt])
}

/// One-time tokens for email verification
model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time tokens for password reset flows
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
